{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decentralabs:glb-fmi-bindings:1.3.0",
  "title": "DecentraLabs FMI bindings for glTF nodes, version 1.3.0",
  "description": "Schema for the value of nodes[*].extras.fmiBindings in a glTF 2.0 or GLB asset. FMU-dependent semantics are validated separately.",
  "$comment": "Apply this schema to the fmiBindings value on a glTF node. Unknown properties are ignored by 1.x readers. See fmi-glb-bindings-contract.md for normative semantics.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/binding"
  },
  "examples": [
    [
      {
        "variable": "gatePosition",
        "target": "position.x",
        "scale": 1,
        "offset": 0
      },
      {
        "variable": "gateOpen",
        "target": "visible"
      },
      {
        "variable": "gateOpen",
        "target": "material.color",
        "trueColor": "#42d392",
        "falseColor": "#62343b"
      }
    ],
    [
      {
        "variable": "doorState",
        "target": "visible",
        "valueMap": { "0": false, "1": true }
      },
      {
        "variable": "temperatureBand",
        "target": "material.color",
        "valueMap": { "cold": "#42d392", "hot": "#ff2738" }
      }
    ],
    [
      {
        "variable": "loadAngleCommand",
        "target": "rotation.x",
        "scale": 1,
        "offset": 0
      }
    ]
  ],
  "$defs": {
    "binding": {
      "type": "object",
      "required": [
        "variable",
        "target"
      ],
      "properties": {
        "variable": {
          "type": "string",
          "minLength": 1,
          "description": "Exact FMI variable name declared by the selected FMU."
        },
        "target": {
          "type": "string",
          "description": "Scalar rotation axes can be driven by outputs or bound to numeric inputs for interactive dragging. Whole-vector rotation remains output-only.",
          "enum": [
            "position.x",
            "position.y",
            "position.z",
            "translation.x",
            "translation.y",
            "translation.z",
            "translation",
            "rotation",
            "scale",
            "weights",
            "rotation.x",
            "rotation.y",
            "rotation.z",
            "scale.x",
            "scale.y",
            "scale.z",
            "visible",
            "material.color"
          ]
        },
        "scale": {
          "type": "number",
          "default": 1,
          "description": "Multiplier in sceneValue = fmiValue * scale + offset, applied to each vector element for whole-vector targets. Draggable inputs require a non-zero value."
        },
        "offset": {
          "type": "number",
          "default": 0,
          "description": "Offset in sceneValue = fmiValue * scale + offset."
        },
        "visibleWhenGreaterThanOrEqual": {
          "type": "number",
          "description": "Optional numeric threshold used only with target visible."
        },
        "trueColor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777215
            }
          ],
          "description": "Optional Three.js color string or 24-bit hexadecimal color integer used for a true-like FMI value."
        },
        "falseColor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777215
            }
          ],
          "description": "Optional Three.js color string or 24-bit hexadecimal color integer used for a false-like FMI value."
        },
        "valueMap": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 128,
          "propertyNames": { "maxLength": 128 },
          "description": "Optional exact mapping from String(FMI value) to a Boolean for visible or a Three.js color value for material.color.",
          "additionalProperties": {
            "oneOf": [
              { "type": "boolean" },
              { "type": "string", "minLength": 1, "pattern": "\\S" },
              { "type": "integer", "minimum": 0, "maximum": 16777215 }
            ]
          }
        },
        "indices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Zero-based, row-major coordinate tuple selecting one element from an FMI array. Required for array values bound to scalar scene targets."
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based glTF morph-target weight index when target is weights and one scalar FMI value drives one morph target. Combine with indices to select an FMI array element."
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["index"]
          },
          "then": {
            "properties": {
              "target": { "const": "weights" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "target": { "enum": ["translation", "rotation", "scale"] }
            },
            "required": ["target"]
          },
          "then": {
            "not": {
              "required": ["indices"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "target": { "const": "weights" }
            },
            "required": ["target", "indices"]
          },
          "then": {
            "required": ["index"]
          }
        },
        {
          "if": {
            "required": ["valueMap"]
          },
          "then": {
            "properties": {
              "target": { "enum": ["visible", "material.color"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "target": { "const": "visible" },
              "valueMap": { "type": "object" }
            },
            "required": ["target", "valueMap"]
          },
          "then": {
            "properties": {
              "valueMap": { "additionalProperties": { "type": "boolean" } }
            },
            "not": { "required": ["visibleWhenGreaterThanOrEqual"] }
          }
        },
        {
          "if": {
            "properties": {
              "target": { "const": "material.color" },
              "valueMap": { "type": "object" }
            },
            "required": ["target", "valueMap"]
          },
          "then": {
            "properties": {
              "valueMap": {
                "additionalProperties": {
                  "oneOf": [
                    { "type": "string", "minLength": 1, "pattern": "\\S" },
                    { "type": "integer", "minimum": 0, "maximum": 16777215 }
                  ]
                }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
