# Copy to .env.local and fill only the values used by your deployment.
# NODE_ENV is managed by Next.js and should not be set here.

# Marketplace origin used by server code and SAML Service Provider endpoints.
# Keep it equal to the origin registered for the SAML Service Provider.
MARKETPLACE_BASE_URL=http://localhost:3000

# Public application configuration
NEXT_PUBLIC_ENABLE_MOCK_SSO=false
NEXT_PUBLIC_DEMO_ALLOW_HTTP_DEV=false
NEXT_PUBLIC_RELEASE_ID=
NEXT_PUBLIC_VERCEL_BLOB_BASE_URL=
NEXT_PUBLIC_ALLOWED_DOCUMENT_ORIGINS=
ALLOWED_METADATA_ORIGINS=
CSP_IMG_SRC=
CSP_CONNECT_SRC=
CSP_FRAME_SRC=
BLOB_READ_WRITE_TOKEN=

# Public contract and RPC configuration
NEXT_PUBLIC_DIAMOND_CONTRACT_ADDRESS_ETHEREUM=
NEXT_PUBLIC_DIAMOND_CONTRACT_ADDRESS_POLYGON=
NEXT_PUBLIC_DIAMOND_CONTRACT_ADDRESS_SEPOLIA=
NEXT_PUBLIC_DEFAULT_MAINNET_URL=
NEXT_PUBLIC_DEFAULT_POLYGON_URL=
NEXT_PUBLIC_DEFAULT_SEPOLIA_URL=
NEXT_PUBLIC_ALCHEMY_ID=
NEXT_PUBLIC_ALCHEMY_MAINNET_URL=
NEXT_PUBLIC_ALCHEMY_POLYGON_URL=
NEXT_PUBLIC_ALCHEMY_SEPOLIA_URL=
NEXT_PUBLIC_ANKR_ID=
NEXT_PUBLIC_ANKR_SEPOLIA_URL=
NEXT_PUBLIC_QUICKNODE_ID=
NEXT_PUBLIC_QUICKNODE_SEPOLIA_URL=
NEXT_PUBLIC_CHAINSTACK_ID=
NEXT_PUBLIC_CHAINSTACK_SEPOLIA_URL=
NEXT_PUBLIC_INFURA_ID=
INFURA_SECRET_KEY=

# SAML Identity Provider and Service Provider signing material
NEXT_PUBLIC_SAML_IDP_METADATA_URL=
NEXT_PUBLIC_SAML_TEST_IDP_METADATA_URL=
NEXT_PUBLIC_SAML_STABLE_USER_ID_MODE=
SAML_SP_PRIVATE_KEY=
SAML_SP_CERTIFICATE=
SAML_TRANSACTION_TTL_SECONDS=

# Server sessions, Redis REST, and logout protection
SESSION_SECRET=
# Preserve the active encryption value when migrating an existing deployment.
SESSION_STORE_ENCRYPTION_KEY=
LOGOUT_CSRF_SECRET=
# Point these at the Redis instance currently used by Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=
SESSION_STORE_TIMEOUT_MS=
SESSION_STORE_MAX_ATTEMPTS=
SESSION_STORE_CIRCUIT_FAILURES=
SESSION_STORE_CIRCUIT_COOLDOWN_MS=
REDIS_REST_TIMEOUT_MS=

# Marketplace JWT, intents, and invitations
JWT_PRIVATE_KEY=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY=
JWT_PREVIOUS_PUBLIC_KEY=
JWT_ISSUER=
JWT_EXPIRATION_MS=
MARKETPLACE_BACKEND_JWT_TTL_SECONDS=
INTENTS_JWT_EXPIRATION_SECONDS=
WALLET_PRIVATE_KEY=
INTENT_ADMIN_ADDRESS=
INTENT_EXECUTOR_ADDRESS=
INTENT_TRUSTED_SIGNER=
INSTITUTION_INVITE_AUDIENCE=
INSTITUTION_INVITE_EXPIRATION_SECONDS=

# Provisioning, policy, and internal integrations
PROVISIONING_DEFAULT_COUNTRY=
PROVISIONING_TOKEN_TTL_SECONDS=
PROVISIONING_PAIRING_TTL_SECONDS=
PROVISIONING_SIGNER_WAIT_MS=
PROVISIONING_ALERT_WEBHOOK_URL=
MARKETPLACE_PLATFORM_ADMIN_EMAILS=
DOCUMENT_MALWARE_SCAN_URL=
DOCUMENT_MALWARE_SCAN_TOKEN=
FMU_REVOCATION_RECONCILIATION_TOKEN=
PROVISIONING_AUDIT_RETENTION_SECONDS=
MARKET_SNAPSHOT_REFRESH_LOCK_SECONDS=
MARKET_SNAPSHOT_RETENTION_SECONDS=
MARKET_SNAPSHOT_RETRY_COOLDOWN_SECONDS=
MARKET_SNAPSHOT_REVALIDATE_SECONDS=

# Optional local provisioning audit tool
RPC_URL=
MORALIS_ID=
MORALIS_SEPOLIA_URL=
INFURA_SEPOLIA_RPC_URL=
PROVISIONING_AUDIT_OUTPUT=
PROVISIONING_AUDIT_FROM_BLOCK=
PROVISIONING_AUDIT_BLOCK_CHUNK=
PROVISIONING_AUDIT_QUERY_CONCURRENCY=

# Test-only settings belong in CI or a dedicated local test environment:
# E2E_TEST, ENABLE_TEST_JWT_ENDPOINT, TEST_JWT_API_KEY,
# RUN_VERCEL_BLOB_INTEGRATION, Cypress live/release-gate variables.
# Vercel automation credentials belong in GitHub Actions secrets:
# VERCEL_TOKEN, VERCEL_PROJECT_ID, VERCEL_TEAM_ID.
