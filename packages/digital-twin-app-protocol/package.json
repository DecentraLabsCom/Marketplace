{
  "name": "@decentralabs/digital-twin-app-protocol",
  "version": "2.0.0",
  "description": "Optional host authorization and direct FMU WebSocket clients for provider apps.",
  "browserBundleFile": "index.js",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "import": "./client.js",
      "default": "./client.js"
    },
    "./batch-controller": {
      "types": "./batch-controller.d.ts",
      "import": "./batch-controller.js",
      "default": "./batch-controller.js"
    },
    "./input-update-quota": {
      "types": "./input-update-quota.d.ts",
      "import": "./input-update-quota.js",
      "default": "./input-update-quota.js"
    },
    "./scene-presentation": {
      "types": "./scene-presentation.d.ts",
      "import": "./scene-presentation.js",
      "default": "./scene-presentation.js"
    },
    "./scene-presentation-schema": "./scene-presentation.schema.json",
    "./schema-v2": "./schema-v2.json",
    "./fmu-client": {
      "types": "./fmu-client.d.ts",
      "import": "./fmu-client.js",
      "default": "./fmu-client.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "client.js",
    "client.d.ts",
    "batch-controller.js",
    "batch-controller.d.ts",
    "input-update-quota.js",
    "input-update-quota.d.ts",
    "README.md",
    "schema-v2.json",
    "fmu-client.js",
    "fmu-client.d.ts",
    "scene-presentation.js",
    "scene-presentation.d.ts",
    "scene-presentation.schema.json"
  ],
  "sideEffects": false,
  "browserClientFile": "client.js"
}
